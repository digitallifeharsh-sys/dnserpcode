<h1 class="h3 mb-2">Security settings</h1><p class="text-muted">Configure 2Factor.in to require OTP verification for every login.</p><% if (success) { %><div class="alert alert-success"><%= success %></div><% } %><form method="post" action="/settings" class="card border-0 shadow-sm"><div class="card-body"><label class="form-label">2Factor API key</label><input class="form-control" type="password" name="twofactor_api_key" autocomplete="new-password" placeholder="<%= apiKeySet ? 'Key saved; enter a replacement to update' : 'Paste API key' %>" <%= apiKeySet ? '' : 'required' %>><div class="form-text">The key is stored in the database and is never displayed after saving.</div></div><div class="card-footer bg-white"><button class="btn btn-primary">Save API key</button></div></form>
