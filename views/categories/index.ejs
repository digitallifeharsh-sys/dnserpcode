<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1 class="h3 mb-1">Category master</h1><p class="text-muted mb-0">Manage categories and their linked subcategories.</p></div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-5">
        <form method="post" action="/categories" class="card border-0 shadow-sm h-100">
            <div class="card-body"><h2 class="h5">Add category</h2><label class="form-label" for="category-name">Category name</label><input class="form-control" id="category-name" name="name" maxlength="120" required></div>
            <div class="card-footer bg-white"><button class="btn btn-primary">Save category</button></div>
        </form>
    </div>
    <div class="col-lg-7">
        <form method="post" action="/categories/subcategories" class="card border-0 shadow-sm h-100">
            <div class="card-body"><h2 class="h5">Add subcategory</h2><label class="form-label" for="subcategory-category">Parent category</label><select class="form-select mb-3" id="subcategory-category" name="category_id" required><option value="">Select a category</option><% activeCategories.forEach(category => { %><option value="<%= category.id %>"><%= category.name %></option><% }) %></select><label class="form-label" for="subcategory-name">Subcategory name</label><input class="form-control" id="subcategory-name" name="name" maxlength="120" required></div>
            <div class="card-footer bg-white"><button class="btn btn-primary" <%= activeCategories.length ? '' : 'disabled' %>>Save subcategory</button></div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white"><h2 class="h5 mb-0">Categories and subcategories</h2></div>
    <% if (!categories.length) { %><div class="card-body text-muted">No categories yet. Add a category to get started.</div><% } else { %>
    <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Category</th><th>Subcategories</th><th>Status</th></tr></thead><tbody>
        <% categories.forEach(category => { %><tr><td class="fw-semibold"><%= category.name %></td><td><% if (category.subcategories.length) { %><%= category.subcategories.map(subcategory => subcategory.name).join(', ') %><% } else { %><span class="text-muted">No subcategories</span><% } %></td><td><span class="badge <%= category.isActive ? 'bg-success' : 'bg-secondary' %>"><%= category.isActive ? 'Active' : 'Inactive' %></span></td></tr><% }) %>
    </tbody></table></div><% } %>
</div>
