<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3">Users & permissions</h1><p class="text-muted mb-0">Assign sidebar visibility and action access per user.</p></div></div>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
<div class="card border-0 shadow-sm mb-4"><div class="card-body"><h2 class="h5 mb-3">Add user</h2><form method="post" action="/users"><div class="row g-3"><div class="col-md-6"><label class="form-label">Full name</label><input class="form-control" name="name" required></div><div class="col-md-6"><label class="form-label">Username</label><input class="form-control" name="username" required></div><div class="col-md-6"><label class="form-label">Phone with country code</label><input class="form-control" name="phone" placeholder="919876543210" required></div><div class="col-md-6"><label class="form-label">Temporary password (10+ chars)</label><input class="form-control" type="password" minlength="10" name="password" required></div></div>
<h3 class="h6 mt-4">Permissions</h3><div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Resource</th><th>Show menu</th><% actions.forEach(a => { %><th><%= a %></th><% }) %></tr></thead><tbody><% resources.forEach(r => { %><tr><td><%= r %></td><td><input type="checkbox" name="permissions[ui][]" value="<%= r %>"></td><% actions.forEach(a => { %><td><input type="checkbox" name="permissions[crud][<%= r %>][]" value="<%= a %>"></td><% }) %></tr><% }) %></tbody></table></div><button class="btn btn-primary">Create user</button></form></div></div>
<div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Existing users</h2><div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Username</th><th>Phone</th><th>Status</th></tr></thead><tbody><% users.forEach(u => { %><tr><td><%= u.name %></td><td><%= u.username %></td><td><%= u.phone %></td><td><%= u.is_active ? 'Active' : 'Disabled' %></td></tr><% }) %></tbody></table></div></div></div>
