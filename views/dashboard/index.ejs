<div class="page-heading"><div><h3>Dashboard Overview</h3><p>DNS Academy fee and student summary.</p></div><div class="heading-actions"><a href="/students/new" class="btn btn-primary"><i class="fas fa-plus me-2"></i>New Admission</a></div></div>
<div class="row g-4 mb-4"><% stats.forEach(stat => { %><div class="col-xl-3 col-md-6"><div class="stat-card"><div class="stat-top"><div><p><%= stat.title %></p><h3><%= stat.value %></h3></div><div class="stat-icon <%= stat.color %>"><i class="fas <%= stat.icon %>"></i></div></div></div></div><% }) %></div>
<div class="row g-4">
<div class="col-xl-6"><div class="dashboard-card"><div class="card-heading"><div><h5>Upcoming Scheduled Payments</h5><p>Installments due from today onward</p></div></div><div class="table-responsive"><table class="table custom-table align-middle"><thead><tr><th>Student</th><th>Schedule</th><th>Due Date</th><th>Balance</th></tr></thead><tbody><% upcoming.forEach(item => { %><tr><td><a href="/students/<%= item.id %>"><%= item.student_name %></a></td><td><%= item.title %></td><td><%= new Date(item.due_date).toLocaleDateString('en-IN') %></td><td>₹<%= (Number(item.amount)-Number(item.paid)).toFixed(2) %></td></tr><% }) %><% if (!upcoming.length) { %><tr><td colspan="4" class="text-muted text-center">No upcoming payments.</td></tr><% } %></tbody></table></div></div></div>
<div class="col-xl-6"><div class="dashboard-card"><div class="card-heading"><div><h5>Overdue Payments</h5><p>Past due installments with outstanding balance</p></div></div><div class="table-responsive"><table class="table custom-table align-middle"><thead><tr><th>Student</th><th>Schedule</th><th>Due Date</th><th>Balance</th></tr></thead><tbody><% overdue.forEach(item => { %><tr><td><a href="/students/<%= item.id %>"><%= item.student_name %></a></td><td><%= item.title %></td><td><%= new Date(item.due_date).toLocaleDateString('en-IN') %></td><td class="text-danger">₹<%= (Number(item.amount)-Number(item.paid)).toFixed(2) %></td></tr><% }) %><% if (!overdue.length) { %><tr><td colspan="4" class="text-muted text-center">No overdue payments.</td></tr><% } %></tbody></table></div></div></div>
</div>
