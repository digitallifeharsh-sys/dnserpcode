<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">QR Payment Collection</h1><p class="text-muted mb-0">Create Cashfree QR links for student installments or general collections.</p></div></div>
<% if (success) { %><div class="alert alert-success"><%= success %></div><% } %><% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
<div class="row g-3 mb-4">
    <div class="col-lg-6"><form method="post" action="/qr-collection/student" class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h5">A. Student QR Payment</h2><p class="text-muted small">Payment will be attached to the selected student's installment after Cashfree verifies it.</p>
        <label class="form-label">Student</label><select class="form-select mb-3" id="qr-student" name="student_id" required><option value="">Select student</option><% students.forEach(s => { %><option value="<%= s.id %>"><%= s.student_name %> — <%= s.mobile || 'No mobile' %></option><% }) %></select>
        <label class="form-label">Installment</label><select class="form-select mb-3" id="qr-installment" name="installment_id" required disabled><option value="">Select student first</option></select>
        <label class="form-label">Amount (₹)</label><input class="form-control mb-3" name="amount" type="number" min="0.01" step="0.01" required>
        <button class="btn btn-primary">Generate Student QR</button>
    </div></form></div>
    <div class="col-lg-6"><form method="post" action="/qr-collection/general" class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h5">B. General QR Payment</h2><p class="text-muted small">No student is required. Paid collections stay separate until you link them later.</p>
        <label class="form-label">Payer Name (optional)</label><input class="form-control mb-3" name="payer_name" maxlength="160">
        <label class="form-label">Payer Mobile Number *</label><input class="form-control mb-3" name="payer_phone" type="tel" maxlength="15" pattern="[0-9+ -]{10,15}" required>
        <label class="form-label">Amount (₹) *</label><input class="form-control mb-3" name="amount" type="number" min="0.01" step="0.01" required>
        <button class="btn btn-primary">Generate General QR</button>
    </div></form></div>
</div>
<div class="card border-0 shadow-sm"><div class="card-header bg-white"><h2 class="h5 mb-0">General Collection History</h2></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>ID</th><th>Payer</th><th>Amount</th><th>Date</th><th>Transaction ID</th><th>Status</th><th>QR / Link</th><th>Link to Student</th></tr></thead><tbody>
<% collections.forEach(item => { %><tr><td>#<%= item.id %></td><td><%= item.payer_name || 'Customer' %><small class="d-block text-muted"><%= item.payer_phone || '' %></small></td><td>₹<%= Number(item.amount).toFixed(2) %></td><td><%= new Date(item.paid_at || item.created_at).toLocaleString('en-IN') %></td><td><%= item.reference_number || item.cashfree_link_id || '—' %></td><td><span class="badge <%= item.status === 'PAID' ? 'bg-success' : item.status === 'PENDING' ? 'bg-warning text-dark' : 'bg-secondary' %>"><%= item.status %></span></td><td><% if (item.cashfree_link_url) { %><a href="<%= item.cashfree_link_url %>" target="_blank" rel="noopener">Open link</a><% if (item.status === 'PENDING') { %><div class="general-qr mt-2" data-url="<%= item.cashfree_link_url %>"></div><% } %><% } else { %>—<% } %></td><td>
<% if (item.status === 'PAID' && !item.linked_installment_id) { %><form method="post" action="/qr-collection/<%= item.id %>/link" class="d-flex flex-wrap gap-1"><select class="form-select form-select-sm link-student" name="student_id" required style="min-width:130px"><option value="">Student</option><% students.forEach(s => { %><option value="<%= s.id %>"><%= s.student_name %></option><% }) %></select><select class="form-select form-select-sm link-installment" name="installment_id" required disabled style="min-width:130px"><option value="">Installment</option></select><button class="btn btn-sm btn-outline-primary">Link</button></form><% } else if (item.linked_student_id) { %><%= item.student_name %> — <%= item.installment_title %><% } else { %>—<% } %>
</td></tr><% }) %>
<% if (!collections.length) { %><tr><td colspan="8" class="text-center text-muted py-4">No general collections yet.</td></tr><% } %></tbody></table></div></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
document.querySelectorAll('.general-qr').forEach(el => { if (window.QRCode && el.dataset.url) new QRCode(el, {text: el.dataset.url, width: 110, height: 110}); });
async function loadInstallments(studentId, target) {
    target.innerHTML = '<option value="">Select installment</option>';
    target.disabled = true;
    if (!studentId) return;
    const response = await fetch(`/students/${encodeURIComponent(studentId)}/installments.json`);
    if (!response.ok) return;
    const items = await response.json();
    items.filter(item => item.available > 0).forEach(item => {
        const option = document.createElement('option');
        option.value = item.id;
        option.textContent = `${item.title} — Due ₹${item.available.toFixed(2)}`;
        target.append(option);
    });
    target.disabled = false;
}
const qrStudent = document.getElementById('qr-student');
if (qrStudent) qrStudent.addEventListener('change', () => loadInstallments(qrStudent.value, document.getElementById('qr-installment')));
document.querySelectorAll('.link-student').forEach(select => select.addEventListener('change', () => loadInstallments(select.value, select.closest('form').querySelector('.link-installment'))));
</script>
